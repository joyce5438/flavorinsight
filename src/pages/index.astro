---
import {
	getEmDashCollection,
	getTermsForEntries,
	getSiteSettings,
} from "emdash";
import Base from "../layouts/Base.astro";
import PostCard from "../components/PostCard.astro";
import { resolveBlogSiteIdentity } from "../utils/site-identity";

// Limit to what we render (1 featured + 6 grid). The DB does the slicing
// instead of fetching every post and discarding the tail in JS.
const POSTS_PER_PAGE = 7;

const [{ entries: posts, cacheHint }, settings] = await Promise.all([
	getEmDashCollection("posts", {
		orderBy: { published_at: "desc" },
		limit: POSTS_PER_PAGE + 1, // +1 to detect "view all" need
	}),
	getSiteSettings(),
]);
const { siteTitle, siteTagline } = resolveBlogSiteIdentity(settings);

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

// Trim the lookahead post used to detect overflow
const visiblePosts = posts.slice(0, POSTS_PER_PAGE);
const hasMorePosts = posts.length > POSTS_PER_PAGE;

// Find the first post with a featured image for the hero
const featuredPost = visiblePosts.find((p) => p.data.featured_image);
const featuredIndex = featuredPost ? visiblePosts.indexOf(featuredPost) : -1;

// Get remaining posts (exclude featured if found, limit to 6 for grid)
const gridPosts = visiblePosts
	.filter((_, i) => i !== featuredIndex)
	.slice(0, 6);

// Single batched query for tags across the featured post + grid posts.
// Avoids the N+1 pattern of calling getEntryTerms() per entry.
// Bylines are already hydrated on entry.data.bylines by getEmDashCollection.
const tagEntryIds = [
	...(featuredPost ? [featuredPost.data.id] : []),
	...gridPosts.map((p) => p.data.id),
];
const [tagsByEntry, categoriesByEntry] = await Promise.all([
	getTermsForEntries("posts", tagEntryIds, "tag"),
	getTermsForEntries("posts", tagEntryIds, "category"),
]);

const featuredTags = featuredPost
	? (tagsByEntry.get(featuredPost.data.id) ?? []).map((t) => ({
			slug: t.slug,
			label: t.label,
		}))
	: [];

const featuredCategory = featuredPost
	? (categoriesByEntry.get(featuredPost.data.id) ?? [])[0] ?? { slug: "malaysia", label: "Malaysia" }
	: { slug: "malaysia", label: "Malaysia" };

const gridPostsWithTags = gridPosts.map((post) => ({
	post,
	category: (categoriesByEntry.get(post.data.id) ?? [])[0] ?? { slug: "malaysia", label: "Malaysia" },
	tags: (tagsByEntry.get(post.data.id) ?? []).map((t) => ({
		slug: t.slug,
		label: t.label,
	})),
}));
---

<Base
	title={`${siteTitle} — ${siteTagline}`}
	pageTitle={siteTitle}
	description="風味洞察 From Flavor to Insight — 由 Austin 撰寫，以個人深度視角探索馬來西亞與台灣的飲食文化、歷史脈絡與在地滋味。深度剖析檳城與台南文化對照、巴生肉骨茶、大馬火車自由行全攻略與多元種族社會觀察。"
	canonical="https://flavorinsight.com/"
>
	<header class="band intro home-cover">
		<div class="frame home-cover__inner">
			<div class="home-cover__header">
				<p class="eyebrow home-cover__eyebrow">
					<span class="home-cover__dot"></span>
					FIELD NOTES & ESSAYS · 飲食文化風土誌
				</p>
				<h1 class="intro__title home-cover__title">{siteTitle}</h1>
				{siteTagline && <p class="intro__subtitle home-cover__subtitle">{siteTagline}</p>}
			</div>
		</div>
	</header>

	{
		posts.length === 0 ? (
			<section class="band section">
				<div class="frame">
					<div class="empty-state">
						<h2 class="empty-state__title">No posts yet</h2>
						<p class="empty-state__text">
							Create your first post in the admin panel.
						</p>
						<div class="empty-state__actions">
							<a href="/_emdash/admin/content/posts/new" class="btn">
								Create a post
							</a>
						</div>
					</div>
				</div>
			</section>
		) : (
			<>
				{featuredPost && (
					<section class="band section">
						<div class="frame">
							<PostCard
								post={featuredPost}
								tags={featuredTags}
								variant="feature"
								headingLevel={2}
								priority
							/>
						</div>
					</section>
				)}

				{gridPostsWithTags.length > 0 && (
					<section class="section section--latest" aria-labelledby="latest-posts">
						<div class="frame">
							<div class="section-head">
								<h2 id="latest-posts" class="section-head__title">
									最新探索筆記
								</h2>
								{hasMorePosts && (
									<a href="/posts" class="arrow-link">
										查看全部文章<span class="sr-only"> posts</span>
										<svg
											viewBox="0 0 24 24"
											fill="none"
											stroke="currentColor"
											stroke-width="1.75"
											stroke-linecap="round"
											stroke-linejoin="round"
											aria-hidden="true"
										>
											<path d="M5 12h14" />
											<path d="m12 5 7 7-7 7" />
										</svg>
									</a>
								)}
							</div>
							<div class="post-grid">
								{gridPostsWithTags.map(({ post, tags }) => (
									<PostCard
										post={post}
										tags={tags}
										variant="card"
										headingLevel={3}
									/>
								))}
							</div>
						</div>
					</section>
				)}
			</>
		)
	}
</Base>

<style>
	.home-cover {
		padding-block: clamp(2rem, 1.5rem + 1.2vw, 2.75rem);
	}

	.home-cover__eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		color: var(--color-brand);
		font-weight: 600;
		letter-spacing: 0.08em;
	}

	.home-cover__dot {
		display: inline-block;
		width: 7px;
		height: 7px;
		border-radius: 9999px;
		background: var(--color-brand);
		box-shadow: 0 0 6px var(--color-brand);
	}

	.home-cover__title {
		max-width: none;
		white-space: nowrap;
		font-size: clamp(1.8rem, 1.2rem + 2.2vw, 3.4rem);
		letter-spacing: -0.025em;
		line-height: 1.15;
		margin-top: var(--spacing-3);
	}

	@media (max-width: 680px) {
		.home-cover__title {
			white-space: normal;
			font-size: clamp(1.6rem, 1.3rem + 1.5vw, 2.2rem);
		}
	}

	.home-cover__subtitle {
		font-size: clamp(1.1rem, 0.95rem + 0.6vw, 1.35rem);
		line-height: 1.6;
		color: var(--color-text-secondary);
		max-width: 52ch;
		margin-top: var(--spacing-4);
	}

	.section-head {
		margin-bottom: clamp(1.75rem, 1.2rem + 1.5vw, 2.75rem);
	}

	.post-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		column-gap: clamp(1.8rem, 1.2rem + 1.8vw, 3rem);
		row-gap: clamp(3rem, 2.2rem + 2.5vw, 4.5rem);
	}

	@media (max-width: 900px) {
		.post-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			column-gap: 1.5rem;
			row-gap: 2.75rem;
		}
	}

	@media (max-width: 600px) {
		.post-grid {
			grid-template-columns: 1fr;
			row-gap: 2.5rem;
		}
	}
</style>
