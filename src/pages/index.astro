---
import {
	getEmDashCollection,
	getTermsForEntries,
	getSiteSettings,
} from "emdash";
import Base from "../layouts/Base.astro";
import PostCard from "../components/PostCard.astro";
import { resolveBlogSiteIdentity } from "../utils/site-identity";

// Limit to what we render (1 featured + 6 grid). The DB does the slicing
// instead of fetching every post and discarding the tail in JS.
const POSTS_PER_PAGE = 7;

const [{ entries: posts, cacheHint }, settings] = await Promise.all([
	getEmDashCollection("posts", {
		orderBy: { published_at: "desc" },
		limit: POSTS_PER_PAGE + 1, // +1 to detect "view all" need
	}),
	getSiteSettings(),
]);
const { siteTitle, siteTagline } = resolveBlogSiteIdentity(settings);

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

// Trim the lookahead post used to detect overflow
const visiblePosts = posts.slice(0, POSTS_PER_PAGE);
const hasMorePosts = posts.length > POSTS_PER_PAGE;

// Find the first post with a featured image for the hero
const featuredPost = visiblePosts.find((p) => p.data.featured_image);
const featuredIndex = featuredPost ? visiblePosts.indexOf(featuredPost) : -1;

// Get remaining posts (exclude featured if found, limit to 6 for grid)
const gridPosts = visiblePosts
	.filter((_, i) => i !== featuredIndex)
	.slice(0, 6);

// Single batched query for tags across the featured post + grid posts.
const tagEntryIds = [
	...(featuredPost ? [featuredPost.data.id] : []),
	...gridPosts.map((p) => p.data.id),
];
const [tagsByEntry, categoriesByEntry] = await Promise.all([
	getTermsForEntries("posts", tagEntryIds, "tag"),
	getTermsForEntries("posts", tagEntryIds, "category"),
]);

const featuredTags = featuredPost
	? (tagsByEntry.get(featuredPost.data.id) ?? []).map((t) => ({
			slug: t.slug,
			label: t.label,
		}))
	: [];

const featuredCategory = featuredPost
	? (categoriesByEntry.get(featuredPost.data.id) ?? [])[0] ?? { slug: "malaysia", label: "Malaysia" }
	: { slug: "malaysia", label: "Malaysia" };

const gridPostsWithTags = gridPosts.map((post) => ({
	post,
	category: (categoriesByEntry.get(post.data.id) ?? [])[0] ?? { slug: "malaysia", label: "Malaysia" },
	tags: (tagsByEntry.get(post.data.id) ?? []).map((t) => ({
		slug: t.slug,
		label: t.label,
	})),
}));
---

<Base
	title={`${siteTitle} — ${siteTagline}`}
	pageTitle={siteTitle}
	description="風味洞察 From Flavor to Insight — 由 Austin 撰寫，以個人深度視角探索馬來西亞與台灣的飲食文化、歷史脈絡與在地滋味。深度剖析檳城與台南文化對照、巴生肉骨茶、大馬火車自由行全攻略與多元種族社會觀察。"
	canonical="https://flavorinsight.com/"
>
	<!-- Editorial Masthead (Award-Tier Header) -->
	<header class="editorial-masthead">
		<div class="frame editorial-masthead__inner">
			<!-- Main Masthead Brand Title -->
			<div class="editorial-masthead__title-group">
				<h1 class="editorial-masthead__title">{siteTitle}</h1>
				<span class="editorial-masthead__sub-title">FROM FLAVOR TO INSIGHT</span>
			</div>

			<!-- Literary Tagline & Mission Lead -->
			<div class="editorial-masthead__narrative">
				<p class="editorial-masthead__tagline">{siteTagline}</p>
				<p class="editorial-masthead__desc">
					在常民攤席、鑊氣、辛辣與甘甜之間，尋找各種飲食身世、歷史脈絡與街頭觀察。
				</p>
			</div>

			<!-- Majolica Hairline Emblem Divider -->
			<div class="masthead-divider" aria-hidden="true">
				<span class="masthead-divider__line"></span>
				<span class="majolica-cross-emblem">
					<svg width="36" height="36" viewBox="0 0 42 42" fill="none">
						<path d="M 21.0,2.0 L 24.06,13.61 L 30.55,11.45 L 28.39,17.94 L 40.0,21.0 L 28.39,24.06 L 30.55,30.55 L 24.06,28.39 L 21.0,40.0 L 17.94,28.39 L 11.45,30.55 L 13.61,24.06 L 2.0,21.0 L 13.61,17.94 L 11.45,11.45 L 17.94,13.61 Z" fill="currentColor" />
						<circle cx="21" cy="6.5" r="1" fill="var(--color-bg)" />
						<circle cx="35.5" cy="21" r="1" fill="var(--color-bg)" />
						<circle cx="21" cy="35.5" r="1" fill="var(--color-bg)" />
						<circle cx="6.5" cy="21" r="1" fill="var(--color-bg)" />
						<circle cx="21" cy="21" r="6" fill="var(--color-bg)" />
						<polygon points="21,16.5 25.5,21 21,25.5 16.5,21" fill="currentColor" />
					</svg>
				</span>
				<span class="masthead-divider__line"></span>
			</div>
		</div>
	</header>

	{
		posts.length === 0 ? (
			<section class="band section">
				<div class="frame">
					<div class="empty-state">
						<h2 class="empty-state__title">No posts yet</h2>
						<p class="empty-state__text">
							Create your first post in the admin panel.
						</p>
						<div class="empty-state__actions">
							<a href="/_emdash/admin/content/posts/new" class="btn">
								Create a post
							</a>
						</div>
					</div>
				</div>
			</section>
		) : (
			<>
				{/* 1. Cover Story Feature Post */}
				{featuredPost && (
					<section class="section section--featured">
						<div class="frame">
							<div class="featured-wrapper">
								<PostCard
									post={featuredPost}
									tags={featuredTags}
									variant="feature"
									headingLevel={2}
									priority
								/>
							</div>
						</div>
					</section>
				)}

				{/* 2. Curator's Field Manifesto Callout */}
				<section class="section section--manifesto" aria-label="Curator's Field Note">
					<div class="frame">
						<div class="manifesto-card">
							<div class="manifesto-card__top">
								<span class="manifesto-card__badge">ESSAYS · NOTES</span>
								<span class="manifesto-card__serial" aria-hidden="true">SERIES 01 / AUSTIN</span>
							</div>
							<blockquote class="manifesto-card__quote">
								「食物從不是靜止的標本，而是人、氣候與遷徙歷史在舌尖上折衷交會的現場。走進南洋的茶室與台灣的街巷，每一次咀嚼，都是在拆解一座城市的文化密碼。」
							</blockquote>
							<div class="manifesto-card__footer">
								<div class="manifesto-card__author">
									<div class="manifesto-card__avatar" aria-hidden="true">A</div>
									<div class="manifesto-card__author-details">
										<p class="manifesto-card__author-name">Austin</p>
										<p class="manifesto-card__author-title">飲食文化觀察家 · 慢行筆記發起人</p>
									</div>
								</div>
								<div class="manifesto-card__seal" aria-hidden="true">
									<span>FIELD OBSERVATIONS</span>
								</div>
							</div>
						</div>
					</div>
				</section>

				{/* 3. Recent Notes Post Grid */}
				{gridPostsWithTags.length > 0 && (
					<section class="section section--latest" aria-labelledby="latest-posts">
						<div class="frame">
							<div class="section-head">
								<div class="section-head__title-group">
									<p class="section-head__eyebrow">RECENT NOTES</p>
									<h2 id="latest-posts" class="section-head__title">
										最新風土探索筆記
									</h2>
								</div>
								{hasMorePosts && (
									<a href="/posts" class="arrow-link archive-cta">
										<span>查看全部文章 VIEW ALL</span>
										<svg
											viewBox="0 0 24 24"
											fill="none"
											stroke="currentColor"
											stroke-width="1.75"
											stroke-linecap="round"
											stroke-linejoin="round"
											aria-hidden="true"
										>
											<path d="M5 12h14" />
											<path d="m12 5 7 7-7 7" />
										</svg>
									</a>
								)}
							</div>
							<div class="post-grid">
								{gridPostsWithTags.map(({ post, tags }) => (
									<PostCard
										post={post}
										tags={tags}
										variant="card"
										headingLevel={3}
									/>
								))}
							</div>
						</div>
					</section>
				)}
			</>
		)
	}
</Base>

<style>
	/* ==========================================================================
	   1. Editorial Masthead
	   ========================================================================== */
	.editorial-masthead {
		padding-top: clamp(2rem, 1.8rem + 1.5vw, 3.5rem);
		padding-bottom: clamp(1.5rem, 1.2rem + 1vw, 2.5rem);
		animation: editorialFadeIn 500ms cubic-bezier(0.16, 1, 0.3, 1) both;
	}

	@keyframes editorialFadeIn {
		from {
			opacity: 0;
			transform: translateY(10px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.editorial-masthead__title-group {
		margin-top: 0;
		text-align: center;
	}

	.editorial-masthead__title {
		font-family: var(--font-heading);
		font-size: clamp(2.5rem, 1.8rem + 3vw, 4.8rem);
		font-weight: 700;
		letter-spacing: -0.025em;
		line-height: 1.1;
		color: var(--color-text);
		text-wrap: balance;
		margin: 0;
	}

	.editorial-masthead__sub-title {
		display: block;
		margin-top: 0.75rem;
		font-family: var(--font-mono, monospace);
		font-size: clamp(0.75rem, 0.7rem + 0.25vw, 0.95rem);
		letter-spacing: 0.28em;
		color: var(--color-brand);
		font-weight: 600;
		text-transform: uppercase;
	}

	.editorial-masthead__narrative {
		max-width: 68ch;
		margin: clamp(1.5rem, 1.2rem + 1vw, 2rem) auto 0;
		text-align: center;
	}

	.editorial-masthead__tagline {
		font-family: var(--font-heading);
		font-size: clamp(1.15rem, 1.05rem + 0.4vw, 1.45rem);
		font-style: italic;
		font-weight: 500;
		color: var(--color-text);
		margin-bottom: 0.6rem;
		line-height: 1.4;
	}

	.editorial-masthead__desc {
		font-size: clamp(0.95rem, 0.9rem + 0.2vw, 1.05rem);
		line-height: 1.7;
		color: var(--color-text-secondary);
		text-wrap: pretty;
	}

	/* ==========================================================================
	   2. Masthead Majolica Hairline Divider
	   ========================================================================== */
	.masthead-divider {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 1.5rem;
		margin-top: clamp(2.25rem, 1.8rem + 1.5vw, 3.25rem);
		color: var(--color-border-strong);
	}

	.masthead-divider__line {
		flex: 1;
		height: 1px;
		background: linear-gradient(
			to right,
			transparent,
			var(--color-border) 20%,
			var(--color-border) 80%,
			transparent
		);
	}

	.majolica-cross-emblem {
		display: inline-flex;
		color: var(--color-brand);
		opacity: 0.85;
	}

	/* ==========================================================================
	   4. Featured Wrapper
	   ========================================================================== */
	.section--featured {
		padding-block: clamp(1rem, 0.5rem + 1vw, 2rem);
	}

	.featured-wrapper {
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		padding: clamp(1.25rem, 1rem + 1vw, 2.25rem);
		box-shadow: var(--shadow-card);
		transition: border-color 220ms ease, box-shadow 220ms ease;
	}

	.featured-wrapper:hover {
		box-shadow: var(--shadow-card-hover);
		border-color: var(--color-border-strong);
	}

	/* ==========================================================================
	   5. Curator's Field Manifesto Callout
	   ========================================================================== */
	.section--manifesto {
		padding-block: clamp(2rem, 1.5rem + 2vw, 3.5rem);
	}

	.manifesto-card {
		background: var(--color-fill);
		border: 1px solid var(--color-border);
		border-left: 4px solid var(--color-brand);
		padding: clamp(1.75rem, 1.2rem + 1.8vw, 3rem);
		position: relative;
	}

	.manifesto-card__top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		font-family: var(--font-mono, monospace);
		font-size: 0.72rem;
		letter-spacing: 0.12em;
		color: var(--color-brand);
		font-weight: 600;
		text-transform: uppercase;
		margin-bottom: 1.25rem;
	}

	.manifesto-card__serial {
		color: var(--color-muted);
		font-weight: normal;
	}

	.manifesto-card__quote {
		font-family: var(--font-heading);
		font-size: clamp(1.15rem, 1rem + 0.6vw, 1.55rem);
		line-height: 1.68;
		color: var(--color-text);
		font-style: italic;
		margin: 0 0 1.75rem 0;
		text-wrap: pretty;
	}

	.manifesto-card__footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding-top: 1.25rem;
		border-top: 1px solid var(--color-border);
		flex-wrap: wrap;
		gap: 1rem;
	}

	.manifesto-card__author {
		display: flex;
		align-items: center;
		gap: 12px;
	}

	.manifesto-card__avatar {
		width: 38px;
		height: 38px;
		border-radius: 9999px;
		background: var(--color-brand);
		color: var(--color-on-brand);
		display: flex;
		align-items: center;
		justify-content: center;
		font-weight: 700;
		font-family: var(--font-heading);
		font-size: 1.1rem;
	}

	.manifesto-card__author-name {
		font-weight: 600;
		font-size: 0.95rem;
		color: var(--color-text);
		margin: 0;
		line-height: 1.2;
	}

	.manifesto-card__author-title {
		font-size: 0.78rem;
		color: var(--color-text-secondary);
		margin: 2px 0 0 0;
	}

	.manifesto-card__seal {
		font-family: var(--font-mono, monospace);
		font-size: 0.65rem;
		letter-spacing: 0.16em;
		padding: 4px 10px;
		border: 1px dashed var(--color-border-strong);
		color: var(--color-muted);
		text-transform: uppercase;
	}

	/* ==========================================================================
	   6. Latest Dispatches Section Head & Grid
	   ========================================================================== */
	.section--latest {
		padding-top: clamp(1.5rem, 1rem + 1.5vw, 2.5rem);
		padding-bottom: clamp(3rem, 2rem + 3vw, 5rem);
	}

	.section-head {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 1rem;
		margin-bottom: clamp(2rem, 1.5rem + 1.5vw, 3rem);
		padding-bottom: 1rem;
		border-bottom: 1px solid var(--color-border);
	}

	.section-head__eyebrow {
		font-family: var(--font-mono, monospace);
		font-size: 0.72rem;
		letter-spacing: 0.14em;
		color: var(--color-brand);
		font-weight: 600;
		text-transform: uppercase;
		margin-bottom: 0.35rem;
	}

	.section-head__title {
		font-family: var(--font-heading);
		font-size: clamp(1.6rem, 1.3rem + 1vw, 2.2rem);
		font-weight: 700;
		letter-spacing: -0.02em;
		color: var(--color-text);
		margin: 0;
	}

	.archive-cta {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		font-family: var(--font-mono, monospace);
		font-size: 0.8rem;
		letter-spacing: 0.08em;
		color: var(--color-text);
		font-weight: 600;
		text-decoration: none;
		transition: color 180ms ease, transform 180ms ease;
	}

	.archive-cta:hover {
		color: var(--color-brand);
		transform: translateX(3px);
	}

	.post-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		column-gap: clamp(1.8rem, 1.2rem + 1.8vw, 3rem);
		row-gap: clamp(3rem, 2.2rem + 2.5vw, 4.5rem);
	}

	@media (max-width: 900px) {
		.post-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			column-gap: 1.5rem;
			row-gap: 2.75rem;
		}
	}

	@media (max-width: 600px) {
		.post-grid {
			grid-template-columns: 1fr;
			row-gap: 2.5rem;
		}
	}
</style>
